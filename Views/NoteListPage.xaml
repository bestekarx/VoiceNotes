<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VoiceNotes.Views.NoteListPage"
             xmlns:viewModels="clr-namespace:VoiceNotes.ViewModels"
             xmlns:models="clr-namespace:VoiceNotes.Models"
             xmlns:helpers="clr-namespace:VoiceNotes.Helpers"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
             Style="{StaticResource ModernPageStyle}"
             Title="VoiceNotes">
    
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Yenile" Command="{Binding LoadNotesCommand}" />
    </ContentPage.ToolbarItems>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Modern Header Section -->
        <Border Grid.Row="0" 
                BackgroundColor="{StaticResource Surface}"
                StrokeThickness="0"
                Margin="0"
                Padding="24,40,24,24">
            <Border.Shadow>
                <Shadow Brush="{StaticResource ShadowLight}" 
                        Offset="0,2" 
                        Opacity="0.1" 
                        Radius="8" />
            </Border.Shadow>
            <StackLayout Spacing="12">
                <Label Text="🎙️ VoiceNotes" 
                       Style="{StaticResource ModernHeaderTextStyle}" />
                <Label Text="Düşüncelerinizi sesli olarak kaydedin" 
                       Style="{StaticResource ModernBodyTextStyle}"
                       HorizontalOptions="Center" />
                
                <!-- Stats Row -->
                <StackLayout Orientation="Horizontal" 
                           HorizontalOptions="Center" 
                           Spacing="24"
                           Margin="0,16,0,0">
                    <StackLayout HorizontalOptions="Center">
                        <Label Text="{Binding Notes.Count}" 
                               FontSize="24" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />
                        <Label Text="Notlar" 
                               Style="{StaticResource ModernCaptionTextStyle}" />
                    </StackLayout>
                    <StackLayout HorizontalOptions="Center">
                        <Label Text="✨" 
                               FontSize="24" />
                        <Label Text="AI Hazır" 
                               Style="{StaticResource ModernCaptionTextStyle}" />
                    </StackLayout>
                </StackLayout>
            </StackLayout>
        </Border>

        <!-- Main Content -->
        <RefreshView Grid.Row="1"
                     Command="{Binding LoadNotesCommand}"
                     IsRefreshing="{Binding IsRefreshing}"
                     RefreshColor="{StaticResource Primary}"
                     BackgroundColor="{StaticResource Background}">
            
            <CollectionView ItemsSource="{Binding Notes}"
                           Style="{StaticResource ModernCollectionViewStyle}"
                           SelectionMode="Single"
                           SelectionChanged="OnNoteSelected">
                
                <CollectionView.EmptyView>
                    <Grid Padding="40">
                        <Border BackgroundColor="{StaticResource Surface}"
                                StrokeThickness="1"
                                Stroke="{StaticResource Outline}"
                                Padding="32"
                                Margin="16,8">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <StackLayout HorizontalOptions="Center" 
                                       VerticalOptions="Center" 
                                       Spacing="20">
                                <Border BackgroundColor="{StaticResource PrimaryContainer}"
                                        StrokeThickness="0"
                                        WidthRequest="80"
                                        HeightRequest="80"
                                        HorizontalOptions="Center">
                                    <Border.StrokeShape>
                                        <Ellipse />
                                    </Border.StrokeShape>
                                    <Label Text="🎙️" 
                                           FontSize="40"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                                
                                <StackLayout Spacing="8">
                                    <Label Text="Henüz not yok" 
                                           Style="{StaticResource ModernSubheaderTextStyle}"
                                           HorizontalOptions="Center" />
                                    <Label Text="İlk notunuzu oluşturmak için + butonuna basın" 
                                           Style="{StaticResource ModernBodyTextStyle}"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center" />
                                </StackLayout>
                                
                                <Border BackgroundColor="{StaticResource SecondaryContainer}"
                                        StrokeThickness="0"
                                        Padding="16,12"
                                        Margin="0,8,0,0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Label Text="AI destekli özetler mevcut!" 
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource OnSecondaryContainer}"
                                           HorizontalOptions="Center" />
                                </Border>
                            </StackLayout>
                        </Border>
                    </Grid>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Note">
                        <Border BackgroundColor="{StaticResource Surface}"
                                StrokeThickness="1"
                                Stroke="{StaticResource Outline}"
                                Padding="20"
                                Margin="16,8">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:NoteListViewModel}}, Path=GoToNoteDetailCommand}"
                                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Note Title -->
                                <Label Grid.Row="0" 
                                       Text="{Binding Title}" 
                                       Style="{StaticResource ModernSubheaderTextStyle}" />

                                <!-- Note Date -->
                                <Label Grid.Row="1" 
                                       Text="{Binding Date, StringFormat='{0:MMM dd, yyyy - HH:mm}'}"
                                       Style="{StaticResource ModernCaptionTextStyle}"
                                       Margin="0,8,0,0" />

                                <!-- Audio Indicator -->
                                <Border Grid.Row="2" 
                                        Margin="0,12,0,0"
                                        BackgroundColor="{StaticResource PrimaryContainer}"
                                        StrokeThickness="0"
                                        Padding="12,8">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <StackLayout Orientation="Horizontal" Spacing="8">
                                        <Label Text="🎙️" 
                                               FontSize="14"
                                               VerticalOptions="Center" />
                                        <Label Text="{Binding AudioRecords.Count, StringFormat='{0} audio clips'}" 
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource OnPrimaryContainer}"
                                               VerticalOptions="Center" />
                                    </StackLayout>
                                </Border>

                                <!-- Action Buttons -->
                                <Grid Grid.Row="3" Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Delete Button -->
                                    <Button Grid.Column="1" 
                                            Text="🗑️" 
                                            BackgroundColor="{StaticResource Error}"
                                            TextColor="White"
                                            HeightRequest="40"
                                            WidthRequest="50"
                                            CornerRadius="20"
                                            FontSize="16"
                                            x:Name="DeleteButton"
                                            Clicked="OnDeleteButtonClicked" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Modern Floating Action Button -->
        <Border Grid.Row="1"
                BackgroundColor="{StaticResource Primary}"
                VerticalOptions="End"
                HorizontalOptions="End"
                Margin="24"
                HeightRequest="64"
                WidthRequest="64">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="32" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="{StaticResource Primary}" 
                        Offset="0,8" 
                        Opacity="0.25" 
                        Radius="16" />
            </Border.Shadow>
            <Button Text="+" 
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource OnPrimary}"
                    FontSize="32"
                    FontAttributes="Bold"
                    Command="{Binding AddNoteCommand}"
                    x:Name="FabButton"
                    CornerRadius="32" />
        </Border>

        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="1" 
                          IsVisible="{Binding IsBusy}"
                          IsRunning="{Binding IsBusy}"
                          Color="{StaticResource Primary}"
                          VerticalOptions="Center"
                          HorizontalOptions="Center" />
    </Grid>
</ContentPage>
